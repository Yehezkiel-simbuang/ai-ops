# Salin menjadi .env. Semua opsional; nilai di bawah adalah bawaan.
PORT=4317
BIND_ADDR=127.0.0.1          # 0.0.0.0 hanya bila Anda tahu risikonya; lebih baik pakai profil tls
LOG_LEVEL=info
ADMIN_USERNAME=admin
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false          # true bila lewat HTTPS
TRUST_PROXY=false            # true bila tepat satu reverse proxy (mis. Caddy) ada di depan aplikasi
DB_POOL_MAX=10
# PUBLIC_URL=https://aiops.contoh.com   # URL yang dipakai agen di server untuk menghubungi aplikasi
# PROJECTS_DIR=D:/work       # folder proyek (hanya-baca): dianalisis untuk halaman Arsitektur dan rencana setup
# PROJECTS_ROOT=/projects
# --- HTTPS di jaringan lokal (profil lan / lan-internal) ---
# DOMAIN=aiops.contoh.com     # nama yang dipakai browser dan agen; record A -> IP privat server ini
# BIND_ADDR=192.168.1.20      # IP LAN server ini (HTTPS hanya mendengarkan di sini)
# HTTPS_PORT=443
# DNS_PROVIDER=cloudflare     # penyedia DNS domain Anda (lihat github.com/caddy-dns)
# DNS_API_TOKEN=...           # token dengan izin edit DNS zona itu SAJA (jaga kerahasiaannya)
# --- Uji beban (profil loadtest) ---
# LOADTEST_ALLOWED_HOSTS=staging.contoh.com,.uji.contoh.com   # host NON-privat yang boleh diuji; kosong = hanya jaringan lokal
# LOADGEN_CPUS=1                                              # batas CPU kontainer pembangkit beban (lebih besar = beban lebih tinggi)
# lalu set: ALLOWED_HOSTS=aiops.contoh.com  PUBLIC_URL=https://aiops.contoh.com  COOKIE_SECURE=true  TRUST_PROXY=true
